{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matra Development 0.2.0",
  "version": "0.2.0",
  "identifier": "com.dydxfx.matra.development020",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "dy/dx.f(M\u0101tr\u0101)",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "incognito": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../LICENSE": "THIRD-PARTY-NOTICES.txt",
      "resources/development-identity.json": "development-identity.json"
    },
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "REPLACE_WITH_TAURI_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
